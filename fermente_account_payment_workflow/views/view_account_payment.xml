<odoo>

    <!-- Customer payment tree view -->
    <record id="view_account_payment_customer_tree" model="ir.ui.view">
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="payment_type" invisible="1"/>
                <field name="journal_type" invisible="1"/>
                <field name="is_checked" widget="boolean_toggle"
                    groups="account.group_account_manager"
                    attrs="{'invisible': [
                        '|', '|',
                        ('payment_type', '=', 'transfer'),
                        ('state', '=', 'draft'),
                        ('journal_type', '!=', 'bank'),
                    ]}"/>
            </field>
        </field>
    </record>

    <!-- Customer payment form view -->
    <record id="view_account_payment_customer_form" model="ir.ui.view">
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="journal_type" invisible="1"/>
                <field name="is_checked" widget="boolean_toggle"
                    groups="account.group_account_manager"
                    attrs="{'invisible': [
                        '|', '|',
                        ('payment_type', '=', 'transfer'),
                        ('state', '=', 'draft'),
                        ('journal_type', '!=', 'bank'),
                    ]}"/>
            </field>
        </field>
    </record>

</odoo>
