<odoo>

    <record id="view_account_move_tree" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="account_export_id" groups="account.group_account_manager" />
            </field>
        </field>
    </record>

    <record id="view_account_move_form" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="account_export_id" groups="account.group_account_manager" />
            </field>
        </field>
    </record>

    <record id="view_account_move_search" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter" />
        <field name="arch" type="xml">
            <filter name="posted" position="after">
                <field name="account_export_id" />
                <filter string="Not Exported" name="not_exported" domain="[('account_export_id', '=', False)]" groups="account.group_account_manager"/>
            </filter>
        </field>
    </record>

    <record id="account.action_move_journal_line" model="ir.actions.act_window">
        <field name="context">{'search_default_not_exported':1}</field>
    </record>

</odoo>
