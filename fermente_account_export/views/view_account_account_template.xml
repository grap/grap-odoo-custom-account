<odoo>

    <record id="view_account_account_template_form" model="ir.ui.view">
        <field name="model">account.account.template</field>
        <field name="inherit_id" ref="account.view_account_template_form" />
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <group string="EBP Settings" colspan="4">
                    <field name="export_suffix_on_tax_required"/>
                    <field name="export_suffix_on_tax_default" attrs="{'invisible': [('export_suffix_on_tax_required', '=', False)]}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
