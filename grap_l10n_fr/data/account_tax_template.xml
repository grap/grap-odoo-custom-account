        <field name="active" eval="True" />
    </record>

    <record id="l10n_fr.tva_import_outside_eu_5_5" model="account.tax.template">
        <field name="name">TVA HA 05,5% extracom</field>
        <field name="description">5.5%</field>
        <field name="tax_scope" eval="False" />
