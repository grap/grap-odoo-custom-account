<odoo>

    <!-- Tax 20% -->
    <record id="tax_20_repartition_invoice_base" model="account.tax.repartition.line">
        <field name="factor_percent">100</field>
        <field name="repartition_type">base</field>
    </record>

    <record id="tax_20_repartition_invoice_tax" model="account.tax.repartition.line">
        <field name="factor_percent">100</field>
        <field name="repartition_type">tax</field>
    </record>

    <record id="tax_20_repartition_refund_base" model="account.tax.repartition.line">
        <field name="factor_percent">100</field>
        <field name="repartition_type">base</field>
    </record>

    <record id="tax_20_repartition_refund_tax" model="account.tax.repartition.line">
        <field name="factor_percent">100</field>
        <field name="repartition_type">tax</field>
    </record>

    <record id="tax_20" model="account.tax">
        <field name="name">Export Demo Tax 20%</field>
        <field name="amount_type">percent</field>
        <field name="amount">20.0</field>
        <field name="price_include" eval="False" />
        <field name="company_id" ref="base.main_company"/>
        <field name="country_id" ref="base.us"/>
        <field name="invoice_repartition_line_ids" eval="[
            Command.link(ref('fermente_account_export_test.tax_20_repartition_invoice_base')),
            Command.link(ref('fermente_account_export_test.tax_20_repartition_invoice_tax')),
        ]"/>
        <field name="refund_repartition_line_ids" eval="[
            Command.link(ref('fermente_account_export_test.tax_20_repartition_refund_base')),
            Command.link(ref('fermente_account_export_test.tax_20_repartition_refund_tax')),
        ]"/>
    </record>

    <record id="tax_20_repartition_invoice_tax" model="account.tax.repartition.line">
        <field name="account_id" ref="tax_account"/>
    </record>

    <record id="tax_20_repartition_refund_tax" model="account.tax.repartition.line">
        <field name="account_id" ref="tax_account"/>
    </record>

</odoo>
