<odoo>

    <!-- Supplier move TREE -->
    <record id="view_account_move_tree_supplier" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <button name="action_move_verify" string="Verify" type="object"
                    attrs="{'invisible':['|',('state', 'not in', ['draft']), ('is_verified', '=', True)]}"/>
                <button name="action_post" type="object"
                    attrs="{'invisible':['|',('state', 'not in', ['draft']), ('is_verified', '=', True)]}"
                    groups="account.group_account_manager" string="Validate"/>
                <field name="is_verified" widget="boolean_toggle" />
            </field>
        </field>
    </record>

    <!-- Common move FORM -->
    <record id="view_account_move_form_supplier" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <div role="alert" position="after">
                <field name="is_verified" invisible="1"/>
                <div class="alert alert-warning" role="alert"
                    attrs="{'invisible': [('is_verified', '=', False)]}">
                    Verified invoice that will be confirmed by an accountant.
                </div>
            </div>

            <!-- Double buttons in native code.. Hide them
                 to recreate one with right access -->
            <xpath
                expr="//button[@name='action_post'][1]"
                position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//button[@name='action_post'][2]"
                position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <button name="button_draft" position="attributes">
                <attribute name="states">cancel</attribute>
            </button>
            <button name="action_post" position="before">
                <button name="action_move_unverify"
                    class="oe_highlight" string="Unverify Bill" type="object"
                    attrs="{'invisible':['|','|', ('state', 'not in', ['draft']), ('is_verified', '=', False), ('move_type', 'not in', ['in_invoice', 'in_refund'])]}"
                    />
                <button name="action_move_verify"
                    class="oe_highlight" string="Verify Bill" type="object"
                    attrs="{'invisible':['|','|', ('state', 'not in', ['draft']), ('is_verified', '=', True), ('move_type', 'not in', ['in_invoice', 'in_refund'])]}"
                    />
                <!-- One for Supplier Invoice, hiden for non manager -->
                <button name="action_post"
                    groups="account.group_account_manager"
                    class="oe_highlight" string="Post" type="object"
                    attrs="{'invisible':['|','|', ('state', 'not in', ['draft']), ('is_verified', '=', True), ('move_type', 'not in', ['in_invoice', 'in_refund'])]}"
                    />
                <!-- One for Customer Invoice -->
                <button name="action_post"
                    class="oe_highlight" string="Validate" type="object"
                    attrs="{'invisible':['|','|', ('state', 'not in', ['draft']), ('is_verified', '=', True), ('move_type', 'in', ['in_invoice', 'in_refund'])]}"
                    />
            </button>

            <!-- Set to readonly when it's verified -->
            <xpath
                expr="//field[@name='invoice_date']"
                position="attributes">
                    <attribute name="attrs">{'readonly': [('is_verified', '=', True)]}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='invoice_date_due']"
                position="attributes">
                    <attribute name="attrs">{'readonly': [('is_verified', '=', True)]}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='supplier_invoice_number']"
                position="attributes">
                    <attribute name="attrs">{'readonly': [('is_verified', '=', True)]}</attribute>
            </xpath>

        </field>
    </record>

</odoo>
