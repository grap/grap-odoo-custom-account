<odoo>

    <!-- Supplier move TREE -->
    <record id="view_account_move_tree_supplier" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <button name="action_move_verify" states="draft" string="Verify" type="object"/>
                <button name="action_post" states="draft,verified" type="object"
                    groups="account.group_account_manager" string="Validate"/>
            </field>
        </field>
    </record>

    <!-- Common move FORM -->
    <record id="view_account_move_form_supplier" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="state" position="attributes">
                <attribute name="statusbar_visible">draft,verified,open,paid</attribute>
            </field>
            <!-- Double buttons in native code.. Hide them
                 to recreate one with right access -->
            <xpath
                expr="//button[@name='action_post'][1]"
                position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//button[@name='action_post'][2]"
                position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <button name="button_draft" position="attributes">
                <attribute name="states">verified,cancel</attribute>
            </button>
            <button name="action_post" position="before">
                <button name="action_move_verify"
                    class="oe_highlight" string="Verify Bill" type="object"
                    attrs="{'invisible':['|',('state', 'not in', ['draft']), ('move_type', 'not in', ['in_invoice', 'in_refund'])]}"
                    />
                <!-- One for Supplier Invoice, hiden for non manager -->
                <button name="action_post"
                    groups="account.group_account_manager"
                    class="oe_highlight" string="Post" type="object"
                    attrs="{'invisible':['|', ('state', 'not in', ['draft','verified']), ('move_type', 'not in', ['in_invoice', 'in_refund'])]}"
                    />
                <!-- One for Customer Invoice -->
                <button name="action_post"
                    class="oe_highlight" string="Validate" type="object"
                    attrs="{'invisible':['|', ('state', 'not in', ['draft','verified']), ('move_type', 'in', ['in_invoice', 'in_refund'])]}"
                    />
            </button>
        </field>
    </record>

</odoo>
